# Copy to .env locally. Never commit real values. Render uses its Environment panel.
APP_ENV=development
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
INGEST_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PORT=8000
# Only list actual trusted proxy IPs/CIDRs. Never use * on a directly exposed server.
FORWARDED_ALLOW_IPS=127.0.0.1
